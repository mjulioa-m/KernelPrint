{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "KernelPrint": {
    "Server": {
      "MaxRequestBodyBytes": 786432,
      "RequestTimeoutMs": 120000,
      "ConcurrencyRetryAfterSeconds": 5,
      "ReadinessHttpProbeUrl": "",
      "ReadinessHttpProbeTimeoutMs": 3000,
      "MaxJsonResponsePdfBytes": 4194304
    },
    "Admin": {
      "ApiKey": ""
    },
    "Profiles": {
      "invoice-a4": {
        "format": "A4",
        "landscape": false,
        "waitFor": {
          "networkIdleMs": 500,
          "fontsReadyTimeoutMs": 5000,
          "maxRenderTimeoutMs": 30000
        }
      }
    },
    "Engine": {
      "TemplateBaseUrl": "http://localhost:3000",
      "MaxConcurrency": 4,
      "BrowserLaunchTimeoutMs": 30000,
      "BrowserRecycleAfterJobs": 200,
      "BrowserRecycleAfterMinutes": 60,
      "Templates": {
        "BlockDataUrls": true,
        "AllowedHosts": [
          "localhost",
          "127.0.0.1",
          "templates"
        ],
        "AllowedSchemes": [
          "http",
          "https"
        ],
        "MaxDataJsonBytes": 524288,
        "MaxNavigationTimeoutMs": 60000,
        "MaxPdfTimeoutMs": 60000,
        "MaxReadySignalTimeoutMs": 30000,
        "EnforceResourceHostAllowlist": true,
        "ExtraResourceAllowedHosts": [
          "fonts.googleapis.com",
          "fonts.gstatic.com"
        ],
        "allowWildcardHosts": false
      }
    },
    "Security": {
      "ApiKey": "",
      "RequireApiKeyInDevelopment": false,
      "Clients": [],
      "RateLimit": {
        "Enabled": true,
        "PermitLimit": 120,
        "WindowSeconds": 60
      }
    }
  },
  "AllowedHosts": "*"
}
